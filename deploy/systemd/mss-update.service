[Unit]
Description=MusicStreamService git watch updater
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/MusicStreamService
EnvironmentFile=-/opt/MusicStreamService/.env
ExecStart=/opt/MusicStreamService/scripts/update-server.sh --watch
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
