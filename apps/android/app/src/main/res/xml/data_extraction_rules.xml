<?xml version="1.0" encoding="utf-8"?>
<!--
  Токены сервисов и сессия MSS зашифрованы ключом из Keystore этого устройства: при переносе
  они всё равно не расшифруются, а в резервной копии были бы лишним следом. Копии отключены.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
