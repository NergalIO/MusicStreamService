# Пример .env для docker compose (-f docker-compose.yml -f docker-compose.app.yml)
# Скопируйте: cp .env.docker.example .env

NODE_ENV=production

POSTGRES_USER=mss
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mss

DATABASE_URL=postgresql://mss:change-me-postgres@postgres:5432/mss
REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-jwt
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OFFLINE_HKDF_SECRET=change-offline-secret

API_PORT=3001
PUBLIC_BASE_PATH=/MusicStreamService
API_PUBLIC_URL=https://your-domain.com/MusicStreamService

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/object-store
UPLOAD_TMP_DIR=./tmp/uploads

GITHUB_REPO=NergalIO/MusicStreamService

# Создаются install-docker-vps.sh (роль admin, premium)
MSS_BOOTSTRAP_ADMIN_EMAIL=
MSS_BOOTSTRAP_ADMIN_PASSWORD=
GITHUB_RELEASE_EXE_NAME=MusicStreamService-setup.exe
GITHUB_RELEASE_APK_NAME=mss-android.apk
BUILD_CLIENT=0
BUILD_APK=0

TRANSCODE_BITRATE_KBPS=112
FFMPEG_PATH=ffmpeg
RELAY_CACHE_TTL_HOURS=48
RELAY_WAIT_MS=120000
PRESENCE_TTL_SEC=90
