DATABASE_URL=postgresql://mss:mss@127.0.0.1:5432/mss
# local — без MinIO (рекомендуется для dev на Windows)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/object-store
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OFFLINE_HKDF_SECRET=change-offline-secret
API_PORT=3001
# Прод: https://your-domain/MusicStreamService (путь = PUBLIC_BASE_PATH)
API_PUBLIC_URL=http://localhost:3001
# Пусто в dev; на VPS: /MusicStreamService
PUBLIC_BASE_PATH=
# Встроенный HTTPS (опционально; иначе TLS на nginx/Caddy)
# TLS_CERT_PATH=/etc/ssl/mss/fullchain.pem
# TLS_KEY_PATH=/etc/ssl/mss/privkey.pem
# Лендинг: установщики в data/releases/
RELEASES_DIR=./data/releases
RELEASE_WINDOWS_FILE=MusicStreamService-setup.exe
RELEASE_ANDROID_FILE=mss-android.apk
# APK на VPS: BUILD_APK=0 или update-server.sh --no-apk — не собирать
# GRADLE_JVM_ARGS=-Xmx768m
# Desktop dev proxy (если API с TLS или другой хост)
# API_DEV_TARGET=https://127.0.0.1:3001
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET_TRACKS=tracks
MINIO_BUCKET_COVERS=covers
TRANSCODE_BITRATE_KBPS=112
FFMPEG_PATH=ffmpeg
UPLOAD_TMP_DIR=./tmp/uploads
NODE_ENV=development

# Federated tracks: relay cache и presence (API + worker)
RELAY_CACHE_TTL_HOURS=48
RELAY_WAIT_MS=120000
PRESENCE_TTL_SEC=90
# ALLOW_SERVER_UPLOAD=true — legacy POST /tracks multipart (по умолчанию 410)

# Desktop: OAuth (только на клиенте)
# Spotify: раздел в навигации; в Developer Dashboard redirect URI http://127.0.0.1:8765/callback и mss://spotify/callback (Android)
# Development Mode: Premium у владельца приложения в Dashboard (обязательно); тестеры — User Management (до 5)
SPOTIFY_CLIENT_ID=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Desktop: Discord Rich Presence (Application ID из Developer Portal)
DISCORD_CLIENT_ID=
# После создания приложения загрузите ассеты Rich Presence (512×512) с ключами logo, play, pause
# из apps/desktop/resources/discord/ — Developer Portal → ваше приложение → Rich Presence → Art Assets
