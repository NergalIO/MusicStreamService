DATABASE_URL=postgresql://mss:mss@127.0.0.1:5432/mss
# local — файлы на диске без S3 (dev). s3 — MinIO или Beget Object Storage.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/object-store
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OFFLINE_HKDF_SECRET=change-offline-secret
API_PORT=3001
# Прод: https://your-domain/MusicStreamService (путь = PUBLIC_BASE_PATH)
API_PUBLIC_URL=http://localhost:3001
# Пусто в dev; на VPS: /MusicStreamService
PUBLIC_BASE_PATH=
# Встроенный HTTPS (опционально; иначе TLS на nginx/Caddy)
# TLS_CERT_PATH=/etc/ssl/mss/fullchain.pem
# TLS_KEY_PATH=/etc/ssl/mss/privkey.pem
# Лендинг: клиенты из GitHub Releases (CI). Legacy: data/releases/
GITHUB_REPO=NergalIO/MusicStreamService
# GITHUB_TOKEN= — опционально, если API rate limit
GITHUB_RELEASE_EXE_NAME=MusicStreamService-setup.exe
GITHUB_RELEASE_APK_NAME=mss-android.apk
RELEASES_DIR=./data/releases
RELEASE_WINDOWS_FILE=MusicStreamService-setup.exe
RELEASE_ANDROID_FILE=mss-android.apk
BUILD_CLIENT=0
BUILD_APK=0
# Legacy VPS-сборка: update-server.sh --client --apk
# GRADLE_JVM_ARGS=-Xmx768m
# Desktop dev proxy (если API с TLS или другой хост)
# API_DEV_TARGET=https://127.0.0.1:3001
# GitHub Actions release (Windows .exe) — добавьте те же значения в Repository secrets:
# API_PUBLIC_URL, SPOTIFY_CLIENT_ID, YANDEX_CLIENT_ID, YANDEX_CLIENT_SECRET, DISCORD_CLIENT_ID
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_ACCESS_KEY_TRACKS=
MINIO_SECRET_KEY_TRACKS=
MINIO_ACCESS_KEY_COVERS=
MINIO_SECRET_KEY_COVERS=
MINIO_BUCKET_TRACKS=tracks
MINIO_BUCKET_COVERS=covers
# Beget Object Storage (бакеты создавать в панели, не через API).
# У каждого бакета своя пара ключей; без MINIO_*_TRACKS/COVERS берётся общая пара выше.
# STORAGE_BACKEND=s3
# MINIO_ENDPOINT=s3.ru1.storage.beget.cloud
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_REGION=ru1
# MINIO_ACCESS_KEY_TRACKS=
# MINIO_SECRET_KEY_TRACKS=
# MINIO_ACCESS_KEY_COVERS=
# MINIO_SECRET_KEY_COVERS=
# Ключи только на API и worker. CORS на бакете для ПК: GET, HEAD, заголовок Range;
# origin — dev Electron (http://localhost:…). PUT из клиента идёт из Electron main, без CORS.
# Android (ExoPlayer) CORS не использует.
TRANSCODE_BITRATE_KBPS=112
FFMPEG_PATH=ffmpeg
UPLOAD_TMP_DIR=./tmp/uploads
NODE_ENV=development

# Listening party (lobby)
# LOBBY_MAX_MEMBERS=8
# LOBBY_IDLE_TTL_MIN=120
# LOBBY_SUGGEST_PER_HOUR=30

# Federated tracks: relay cache и presence (API + worker)
RELAY_CACHE_TTL_HOURS=48
RELAY_WAIT_MS=120000
PRESENCE_TTL_SEC=90
# ALLOW_SERVER_UPLOAD=true — legacy POST /tracks multipart (по умолчанию 410)

# Подтверждение email при регистрации (OTP на почту). В dev без SMTP код пишется в лог API.
# EMAIL_VERIFICATION_REQUIRED=false — без OTP (SMTP не нужен; только для доверенного/личного сервера).
EMAIL_VERIFICATION_REQUIRED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MusicStreamService <noreply@your-domain.com>
EMAIL_VERIFICATION_TTL_MIN=15

# Desktop: Spotify больше не требует Client ID — встроен веб-плеер open.spotify.com.
# Android (опционально): SPOTIFY_CLIENT_ID, redirect mss://spotify/callback
SPOTIFY_CLIENT_ID=
# Яндекс: оставьте пустым — используется OAuth клиента «Яндекс Музыка» (Плюс и полные треки).
# Свой oauth.yandex.ru без MSS_YANDEX_CUSTOM_OAUTH=1 даёт только превью.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# MSS_YANDEX_CUSTOM_OAUTH=1

# Desktop: Discord Rich Presence (Application ID из Developer Portal)
DISCORD_CLIENT_ID=
# После создания приложения загрузите ассеты Rich Presence (512×512) с ключами logo, play, pause
# из apps/desktop/resources/discord/ — Developer Portal → ваше приложение → Rich Presence → Art Assets
